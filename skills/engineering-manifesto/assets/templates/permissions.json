{
  "deny": [
    "Read(.env)",
    "Read(.env.local)",
    "Read(.env.production)",
    "Read(.env.*.local)",
    "Read(secrets/**)",
    "Edit(.env)",
    "Edit(.env.local)",
    "Edit(.env.production)",
    "Edit(.env.*.local)",
    "Bash(git push --force *)",
    "Bash(git push -f *)",
    "Bash(git push * --force*)",
    "Bash(git push * -f)",
    "Bash(git push * -f *)"
  ],
  "ask": [
    "Bash(rm -rf *)",
    "Bash(git reset --hard *)",
    "Bash(git clean -fd *)",
    "Bash(git clean -fdx *)"
  ]
}
